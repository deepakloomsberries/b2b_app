# Flask secret key — set to a long random string (e.g. python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=replace-with-a-long-random-string

# Default admin credentials (used only on first run if no admin user exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Google Sheets integration
GOOGLE_SERVICE_ACCOUNT_JSON=/absolute/path/to/service_account.json
STOCK_SHEET_ID=your-stock-sheet-id
STOCK_SHEET_TAB_NAME=Stock
ORDERS_SHEET_ID=your-orders-sheet-id
ORDERS_SHEET_TAB_NAME=Orders

# Optional: timeouts (seconds) for Google Sheets API calls, so a stalled
# network never hangs an export. Defaults: connect 10s, read 30s.
# SHEETS_CONNECT_TIMEOUT=10
# SHEETS_READ_TIMEOUT=30

# Optional: custom database path (default: app.db in project root)
# DATABASE_PATH=/path/to/custom/app.db

# Optional: server port (default: 8000)
# PORT=8000

# Optional: enable Flask debug mode (never use in production)
# FLASK_DEBUG=0
